{
  "brand": "Taiseel",
  "source": "User-supplied zillow-clean.html and zillow-rwanda-v3.html; the source HTML/CSS is the implementation reference.",
  "principles": [
    "preserve the supplied home and search page structure",
    "preserve the distinct typography and geometry of each supplied page",
    "localise market labels and units for Rwanda",
    "keep listings and map information clearly marked as demo data",
    "maintain transparent cyan administrative boundary outlines"
  ],
  "colors": {
    "canvas": "#ffffff",
    "surface": "#f5f5f5",
    "textPrimary": "#1a1a1a",
    "textSecondary": "#555555",
    "border": "#e0e0e0",
    "accent": "#006aff",
    "accentHover": "#0051cc",
    "mapBoundary": "#00b9e8",
    "mapBoundaryOpacity": 0.82,
    "focus": "#bfdfff",
    "danger": "#c0392b"
  },
  "typography": {
    "home": "Open Sans, Arial, Helvetica, sans-serif",
    "search": "Inter, -apple-system, BlinkMacSystemFont, sans-serif",
    "homeHero": {
      "size": "48px",
      "lineHeight": 1.15,
      "weight": 700
    },
    "searchBase": {
      "size": "13px",
      "weight": 400
    },
    "fontNotes": "Keep each screen's source font. Do not unify the two screens into one new design system."
  },
  "layout": {
    "home": {
      "navbarHeight": "56px",
      "sidebarWidth": "65px",
      "heroHeight": "378px",
      "searchWidth": "370px"
    },
    "search": {
      "navbarHeight": "44px",
      "filterbarHeight": "52px",
      "sidebarWidth": "64px",
      "mapWidth": "60vw",
      "resultsWidth": "40%"
    },
    "searchCardColumns": 2,
    "mobileSearch": "map stacked above results",
    "responsiveBreakpoints": [
      "1050px",
      "900px",
      "760px",
      "680px",
      "440px",
      "420px"
    ]
  },
  "radius": {
    "small": "4px",
    "card": "8px",
    "largeModal": "12px",
    "pill": "24px"
  },
  "shadows": {
    "card": "0 2px 16px rgba(0,0,0,0.12)",
    "heroSearch": "0 2px 8px rgba(0,0,0,0.15)"
  },
  "motion": {
    "hover": "150ms",
    "reducedMotion": "honor prefers-reduced-motion"
  },
  "mapBoundaries": {
    "normalWeight": "1.05px",
    "hoverWeight": "3px",
    "selectedWeight": "3.5px",
    "fillOpacity": 0
  }
}
